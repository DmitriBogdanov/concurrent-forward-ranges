{
    "version": 3,
    
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    
    "configurePresets": [
        {
            "name"       : "base",
            "description": "Common configuration variables.",
            "binaryDir"  : "build/",
            "hidden"     : true
        },
        {
            "name"          : "gcc",
            "description"   : "GCC configuration variables.",
            "inherits"      : [ "base" ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER"       : "g++",
                "UNIT_TEST_COMPILE_OPTIONS": "-O0;-g3;-Wall;-Wextra;-Wpedantic;-Werror;-fsanitize=address,undefined;-fno-sanitize-recover=all",
                "UNIT_TEST_LINKAGE_OPTIONS": "-fsanitize=address,undefined"
            }
        },
        {
            "name"          : "clang",
            "description"   : "Clang configuration variables.",
            "inherits"      : [ "base" ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER"       : "clang++",
                "UNIT_TEST_COMPILE_OPTIONS": "-stdlib=libc++;-O0;-g3;-Wall;-Wextra;-Wpedantic;-Werror;-fsanitize=address,undefined;-fno-sanitize-recover=all",
                "UNIT_TEST_LINKAGE_OPTIONS": "-stdlib=libc++;-fsanitize=address,undefined"
            }
        },
        {
            "name"       : "msvc",
            "description": "MSVC configuration variables.",
            "inherits"   : [ "base" ],
            "cacheVariables": {
                "CMAKE_CXX_FLAGS_DEBUG"    : "",
                "CMAKE_CXX_FLAGS_RELEASE"  : "",
                "UNIT_TEST_COMPILE_OPTIONS": "/W4;/sdl;/WX;/DEBUG;/Zi;/RTC1;/permissive-;/Zc:preprocessor",
                "UNIT_TEST_LINKAGE_OPTIONS": ""
            }
        }
    ],
    
    "buildPresets": [
        {
            "name"       : "base",
            "description": "Common build variables.",
            "hidden"     : true,
            "jobs"       : 6
        },
        { "name": "gcc"  , "configurePreset": "gcc"  , "inherits": [ "base" ] },
        { "name": "clang", "configurePreset": "clang", "inherits": [ "base" ] },
        { "name": "msvc" , "configurePreset": "msvc" , "inherits": [ "base" ] }
    ],
    
    "testPresets": [
        {
            "name"       : "base",
            "description": "CTest arguments",
            "hidden"     : true,
            "output"     : { "outputOnFailure": true },
            "execution"  : { "timeout"        : 60   }
        },
        { "name": "gcc"  , "configurePreset": "gcc"  , "inherits": [ "base" ] },
        { "name": "clang", "configurePreset": "clang", "inherits": [ "base" ] },
        { "name": "msvc" , "configurePreset": "msvc" , "inherits": [ "base" ] }
    ]
}
