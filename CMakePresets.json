{
    "version": 3,
    
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    
    "configurePresets": [
        {
            "name": "base",
            "description": "Common configuration variables.",
            "hidden": true,
            "binaryDir": "build/",
            "cacheVariables": {
                "CFR_COMPILE_FEATURES": "cxx_std_23"
            }
        },
        {
            "name": "gcc",
            "description": "GCC configuration variables.",
            "inherits": [ "base" ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER"      : "g++",
                "CFR_TEST_COMPILE_OPTIONS": "-stdlib=libstdc++;-O0;-g3;-Wall;-Wextra;-Wpedantic;-Werror;-fsanitize=address,undefined;-fno-sanitize-recover=all",
                "CFR_TEST_LINK_OPTIONS"   : "-stdlib=libstdc++;-fsanitize=address,undefined"
            }
        },
        {
            "name": "clang",
            "description": "Clang configuration variables.",
            "inherits": [ "base" ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER"      : "clang++",
                "CFR_TEST_COMPILE_OPTIONS": "-stdlib=libc++;-O0;-g3;-Wall;-Wextra;-Wpedantic;-Werror;-fsanitize=address,undefined;-fno-sanitize-recover=all",
                "CFR_TEST_LINK_OPTIONS"   : "-stdlib=libc++;-fsanitize=address,undefined"
            }
        },
        {
            "name": "msvc",
            "description": "MSVC configuration variables.",
            "inherits": [ "base" ],
            "cacheVariables": {
                "CMAKE_CXX_FLAGS_DEBUG"   : "",
                "CMAKE_CXX_FLAGS_RELEASE" : "",
                "CFR_TEST_COMPILE_OPTIONS": "/W4;/sdl;/WX;/DEBUG;/Zi;/RTC1;/permissive-;/Zc:preprocessor",
                "CFR_TEST_LINK_OPTIONS"   : ""
            }
        }
    ],
    
    "buildPresets": [
        {
            "name": "base",
            "description": "Common build variables.",
            "hidden": true,
            "jobs": 6
        },
        { "name": "gcc"  , "configurePreset": "gcc"  , "inherits": [ "base" ] },
        { "name": "clang", "configurePreset": "clang", "inherits": [ "base" ] },
        { "name": "msvc" , "configurePreset": "msvc" , "inherits": [ "base" ] }
    ],
    
    "testPresets": [
        {
            "name": "base",
            "description": "CTest arguments",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "timeout": 60
            }
        },
        { "name": "gcc"  , "configurePreset": "gcc"  , "inherits": [ "base" ] },
        { "name": "clang", "configurePreset": "clang", "inherits": [ "base" ] },
        { "name": "msvc" , "configurePreset": "msvc" , "inherits": [ "base" ] }
    ]
}
